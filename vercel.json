{
  "version": 2,
  "name": "builoc2k-denypanel",
  "buildCommand": "",
  "outputDirectory": "denypanel",
  "functions": {
    "api/proxy.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
