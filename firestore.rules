rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: kiểm tra user là admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{uid} {
      // User đọc tài khoản của mình, admin đọc tất cả
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // User tự tạo tài khoản khi đăng ký
      allow create: if request.auth != null && request.auth.uid == uid;
      // Admin sửa bất kỳ, user sửa thông tin của mình
      // Server (payment API) được cộng tiền: chỉ update field 'balance'
      allow update: if request.auth != null && (isAdmin() || request.auth.uid == uid)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']);
    }

    // Pending deposits — server cần đọc/ghi để xử lý nạp tiền
    match /pending_deposits/{ref} {
      // User tạo lệnh nạp tiền của mình
      allow create: if request.auth != null;
      // Server cần đọc để kiểm tra ref code
      allow read: if true;
      // Server/user cập nhật trạng thái (pending → completed)
      allow update: if true;
    }

    // Transactions (lịch sử nạp tiền)
    match /transactions/{txId} {
      allow read: if request.auth != null && isAdmin();
      // Server ghi log giao dịch
      allow create: if true;
    }

    // Settings (pricing, markup)
    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
