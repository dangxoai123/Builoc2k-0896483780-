rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: kiểm tra admin (dùng Firebase Auth)
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // USERS collection
    // ==========================================
    match /users/{userId} {
      // Chủ tài khoản hoặc admin đọc được (bao gồm cả list query của admin)
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Chỉ chủ tài khoản tự cập nhật — nhưng không được tự nâng quyền admin hay đổi balance
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        !('role' in request.resource.data) &&
        !('balance' in request.resource.data.diff(resource.data).affectedKeys());

      // Admin mới update balance và role
      allow write: if request.auth != null && isAdmin();

      // Cho phép tạo account mới (register)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Không ai được tự xóa tài khoản
      allow delete: if false;

      // ==========================================
      // ORDERS sub-collection (cô lập theo user)
      // ==========================================
      match /orders/{orderId} {
        // Chỉ chủ tài khoản hoặc admin đọc được
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());

        // Chủ tài khoản tạo/cập nhật đơn, admin cũng được cập nhật
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());

        // Không xóa đơn
        allow delete: if false;
      }

      // ==========================================
      // TRANSACTIONS sub-collection
      // ==========================================
      match /transactions/{txId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
        allow update, delete: if false;
      }
    }

    // ==========================================
    // TRANSACTIONS collection (top-level, dùng bởi admin)
    // ==========================================
    match /transactions/{txId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }

    // ==========================================
    // PENDING DEPOSITS
    // ==========================================
    match /pending_deposits/{ref} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin();
      allow delete: if false;
    }

    // ==========================================
    // SETTINGS (public config, chỉ đọc)
    // ==========================================
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Từ chối tất cả còn lại
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
