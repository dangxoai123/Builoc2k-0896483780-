rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: kiểm tra user là admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{uid} {
      // User chỉ đọc được tài khoản của mình
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // User tự tạo tài khoản khi đăng ký
      allow create: if request.auth != null && request.auth.uid == uid;
      // Admin có thể sửa bất kỳ user nào, user chỉ sửa được thông tin không nhạy cảm của mình
      allow update: if request.auth != null && (isAdmin() || request.auth.uid == uid);
    }

    // Transactions (lịch sử nạp tiền)
    match /transactions/{txId} {
      allow read, write: if isAdmin();
    }

    // Settings (pricing, markup)
    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
