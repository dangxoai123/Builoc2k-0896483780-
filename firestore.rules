rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{uid} {
      // Cho phép đọc luôn (server payment cần đọc balance)
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      // Admin/user tự sửa, HOẶC server chỉ update field balance
      allow update: if request.auth != null && (isAdmin() || request.auth.uid == uid)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']);
    }

    // Pending deposits — server cần đọc/ghi để xử lý nạp tiền
    match /pending_deposits/{ref} {
      allow create: if request.auth != null;
      allow read:   if true;
      allow update: if true;
    }

    // Transactions — server ghi log, admin/owner xem
    match /transactions/{txId} {
      allow read:   if true; // admin gate bảo vệ trang, không cần Firebase Auth ở đây
      allow create: if true;
    }

    // Orders subcollection — user tự đọc/ghi orders của mình, admin đọc tất cả
    match /users/{uid}/orders/{orderId} {
      allow read:   if true; // admin gate bảo vệ trang admin; user dashboard cũng cần đọc
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    // Settings
    match /settings/{doc} {
      allow read:  if true; // admin gate bảo vệ, không cần Firebase Auth để đọc
      allow write: if isAdmin();
    }
  }
}
