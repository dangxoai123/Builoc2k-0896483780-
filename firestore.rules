rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: kiểm tra admin (hardcode UID hoặc role trong Firestore)
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'iMNN0onFBDMayRjSrykxTVvoFn92' ||  // builoc1906@gmail.com
        request.auth.uid == 'rq67OcWVwRP8j5OoI0Wbj7FE7Zl1' ||  // buinguyenloc112000@gmail.com
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ==========================================
    // USERS collection
    // ==========================================
    match /users/{userId} {
      // List query cho check username khi signup
      allow list: if true;
      // Read: chủ tài khoản hoặc admin
      allow get: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Chủ tài khoản tự cập nhật (không được đổi role/balance)
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        !('role' in request.resource.data) &&
        !('balance' in request.resource.data.diff(resource.data).affectedKeys());

      // Admin update balance và role
      allow write: if request.auth != null && isAdmin();

      // Server webhook cộng balance (không có auth token)
      // Chỉ cho phép update đúng field balance (không thêm field mới)
      allow update: if request.auth == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']);

      // Tạo account mới
      allow create: if request.auth != null && request.auth.uid == userId;

      // Không xóa
      allow delete: if false;

      // ==========================================
      // ORDERS sub-collection (cô lập theo user)
      // ==========================================
      match /orders/{orderId} {
        // Chỉ chủ tài khoản hoặc admin đọc được
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());

        // Chủ tài khoản tạo/cập nhật đơn, admin cũng được cập nhật
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());

        // Không xóa đơn
        allow delete: if false;
      }

      // ==========================================
      // TRANSACTIONS sub-collection
      // ==========================================
      match /transactions/{txId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
        allow update, delete: if false;
      }
    }

    // ==========================================
    // TRANSACTIONS collection (top-level, dùng bởi admin)
    // ==========================================
    match /transactions/{txId} {
      allow read: if request.auth != null && isAdmin();
      // Admin hoặc server (không auth) tạo transaction log
      allow create: if true;
      allow update, delete: if false;
    }

    // ==========================================
    // PENDING DEPOSITS
    // ==========================================
    match /pending_deposits/{ref} {
      // Tất cả đều có thể read (cần cho server webhook check)
      allow read: if true;
      allow create: if request.auth != null;
      // Admin update
      allow update: if request.auth != null && isAdmin();
      // Server webhook update status (không auth)
      allow update: if request.auth == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','txId','completedAt','amount']);
      allow delete: if false;
    }

    // ==========================================
    // SETTINGS (public config, chỉ đọc)
    // ==========================================
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Từ chối tất cả còn lại
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
